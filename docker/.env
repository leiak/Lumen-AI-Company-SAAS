# =============================================================================
# Lumen stack .env — consumed by docker-compose.yml via ${VAR} interpolation.
# Override per-environment by copying to .env.local and re-running compose
# with `docker compose --env-file .env.local ...`.
# =============================================================================

# ---- Image tag applied to every lumen/lumen-*:TAG service. -----------------
LUMEN_IMAGE_TAG=dev

# ---- MySQL ------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=root
MYSQL_PORT=3308
MYSQL_DATABASE=lumen_db

# ---- Redis ------------------------------------------------------------------
REDIS_PASSWORD=redis123
REDIS_PORT=6379

# ---- Nacos (standalone mode, MySQL-backed) ----------------------------------
NACOS_PORT=8848
NACOS_GRPC_PORT=9848
NACOS_AUTH_TOKEN=SecretKey012345678901234567890123456789012345678901234567890123456789
NACOS_AUTH_IDENTITY_KEY=lumen
NACOS_AUTH_IDENTITY_VALUE=lumen

# ---- Lumen service ports (host-side; container ports match) ----------------
LUMEN_GATEWAY_PORT=9200
LUMEN_AUTH_PORT=9201
LUMEN_PLATFORM_PORT=9202
LUMEN_SYSTEM_PORT=9203
LUMEN_ORG_PORT=9204
LUMEN_WORKFLOW_PORT=9205
LUMEN_FILE_PORT=9206
LUMEN_MESSAGE_PORT=9207
LUMEN_HR_PORT=9208
LUMEN_FINANCE_PORT=9209
LUMEN_ASSETS_PORT=9210
LUMEN_CONTRACT_PORT=9211
LUMEN_PROCUREMENT_PORT=9212
LUMEN_SALES_PORT=9213
LUMEN_PAYROLL_PORT=9214
LUMEN_INVENTORY_PORT=9215
LUMEN_BI_PORT=9216
LUMEN_MOBILE_PORT=9217

# ---- Frontend (nginx serving Vue 3 SPA + reverse-proxy /api -> gateway) ----
LUMEN_PORTAL_PORT=8080
